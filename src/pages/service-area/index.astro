---
import Layout from '../../layouts/Layout.astro';
import { PRE_LAUNCH_MODE } from '../../data/business';
import { locations } from '../../data/locations';
import FinalCTA from '../../components/FinalCTA.astro';
---

<Layout
  title={
    PRE_LAUNCH_MODE
      ? 'Planned Lancaster County Service Area'
      : 'Lancaster County Service Area'
  }
  description={`Explore Resolve Junk Solutions’ ${PRE_LAUNCH_MODE ? 'planned ' : ''}Lancaster County coverage. Check individual community status and request confirmation for your property.`}
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Service area', url: '/service-area' },
  ]}
>
  <div class="wrap">
    <section class="page-hero">
      <p class="eyebrow">RIGHT HERE IN LANCASTER COUNTY</p>
      <h1>
        Local service.
        <br />
        Room to breathe.
      </h1>
      <p>
        {PRE_LAUNCH_MODE
          ? 'We’re planning junk removal and cleanouts for homes and properties across Lancaster County, Pennsylvania.'
          : 'Junk removal and cleanouts for homes and properties in Lancaster County, Pennsylvania.'}
      </p>
      <div class="notice">
        The directory shows{' '}
        {locations.some((l) => !l.confirmed)
          ? 'coverage status for each proposed community'
          : 'our confirmed service communities'}
        . These are not separate business locations. Include your service ZIP so
        we can confirm your address.
      </div>
    </section>
    <section
      class="location-cards page-content"
      aria-label="Service communities"
    >
      {locations.map((l) => (
        <article>
          <h2>{l.name}, PA</h2>
          <p class="coverage-status">
            {l.confirmed
              ? PRE_LAUNCH_MODE
                ? 'Planned coverage confirmed'
                : 'Service area'
              : 'Proposed coverage · Not yet confirmed'}
          </p>
          <p>{l.tip}</p>
          <a class="text-link" href={`/service-area/${l.slug}`}>
            Plan a {l.name} request ↗
          </a>
        </article>
      ))}
    </section>
    <div class="section">
      <FinalCTA />
    </div>
  </div>
</Layout>
