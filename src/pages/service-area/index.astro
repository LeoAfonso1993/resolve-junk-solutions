---
import Layout from '../../layouts/Layout.astro';
import { PRE_LAUNCH_MODE } from '../../data/business';
import { locations } from '../../data/locations';
import FinalCTA from '../../components/FinalCTA.astro';
---

<Layout
  title={
    PRE_LAUNCH_MODE
      ? 'Lancaster County Service Area · November 2026 Launch'
      : 'Lancaster County Service Area'
  }
  description="Explore Resolve Junk Solutions’ Lancaster County service area and find information for your community. Start planning your pickup."
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Service area', url: '/service-area' },
  ]}
>
  <div class="wrap">
    <section class="page-hero">
      <p class="eyebrow">RIGHT HERE IN LANCASTER COUNTY</p>
      <h1>
        Local service.
        <br />
        Room to breathe.
      </h1>
      <p>
        {PRE_LAUNCH_MODE
          ? 'Junk removal and cleanouts for Lancaster County, Pennsylvania, beginning November 2026.'
          : 'Junk removal and cleanouts for homes and properties in Lancaster County, Pennsylvania.'}
      </p>
      <div class="notice">
        Find your community below, then include your property’s ZIP when you
        plan your pickup.
      </div>
    </section>
    <section
      class="location-cards page-content"
      aria-label="Service communities"
    >
      {locations.map((l) => (
        <article>
          <h2>{l.name}, PA</h2>
          <p class="coverage-status">Lancaster County</p>
          <p>{l.tip}</p>
          <a class="text-link" href={`/service-area/${l.slug}`}>
            Explore junk removal in {l.name} ↗
          </a>
        </article>
      ))}
    </section>
    <div class="section">
      <FinalCTA />
    </div>
  </div>
</Layout>
