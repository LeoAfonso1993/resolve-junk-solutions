---
import Layout from '../../layouts/Layout.astro';
import { locations, isIndexableLocation } from '../../data/locations';
import ServiceGrid from '../../components/ServiceGrid.astro';
import { PRE_LAUNCH_MODE } from '../../data/business';
import CTA from '../../components/CTA.astro';
import { Image } from 'astro:assets';
import { landmarks } from '../../data/landmarks';
export function getStaticPaths() {
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}
const { location } = Astro.props;
const landmark = landmarks[location.slug];
---

<Layout
  title={`${PRE_LAUNCH_MODE || !location.confirmed ? 'Junk Removal Planning' : 'Junk Removal'} in ${location.name}, PA`}
  description={`Plan a ${location.name}, PA junk removal request with Resolve Junk Solutions. ${location.focus}. Coverage and scheduling require confirmation.`}
  noindex={!isIndexableLocation(location)}
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Service area', url: '/service-area' },
    { name: location.name, url: `/service-area/${location.slug}` },
  ]}
>
  <div class="wrap">
    <section class="page-hero location-hero">
      <div class="location-hero-copy">
        <p class="eyebrow">
          {location.confirmed ? 'SERVICE AREA' : 'PROPOSED SERVICE AREA'} ·
          LANCASTER COUNTY
        </p>
        <h1>
          Making room
          <br />
          in {location.name}.
        </h1>
        <p>{location.tip}</p>
        <CTA />
      </div>
      <figure class="location-landmark">
        <Image
          src={landmark.image}
          alt={landmark.alt}
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 800px) calc(100vw - 40px), (max-width: 1240px) 46vw, 560px"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
          style={`object-position: ${landmark.position}`}
        />
        <figcaption>
          <span class="landmark-name">{landmark.name}</span>
          <details class="landmark-credit">
            <summary>Photo credit</summary>
            <p>
              <a href={landmark.source}>
                {landmark.author} / Wikimedia Commons
              </a>
              {' · '}
              <a href={landmark.licenseUrl} rel="license">
                {landmark.license}
              </a>
              . Resized and cropped for display; image retains this license.
            </p>
          </details>
        </figcaption>
      </figure>
    </section>
    <section class="content-grid page-content">
      <div>
        <h2>
          {PRE_LAUNCH_MODE ? 'Planning service for' : 'Service coverage for'}{' '}
          {location.name}
        </h2>
        <p>
          {location.confirmed
            ? `${location.name} is in our ${PRE_LAUNCH_MODE ? 'planned ' : ''}service area. Tell us about your project so we can review item acceptance and scheduling.`
            : `${location.name} is part of our proposed Lancaster County coverage. We are still confirming our service area, so please include the ZIP for the actual property before making pickup plans.`}
        </p>
        <p>
          Requests can describe a home, rental property, or a property you are
          helping coordinate. Let us know who can approve removal, what needs to
          stay, and how the items can be reached.
        </p>
        <h2>{location.focus}</h2>
        <p>
          Use the guides below to prepare an item list and useful photos. A
          request starts a conversation about scope, access, and timing; it does
          not book a crew or guarantee acceptance.
        </p>
        <a href="/pricing" class="text-link">
          See how an estimate is put together ↗
        </a>
      </div>
      <aside class="callout">
        <h2>From request to removal</h2>
        <ol>
          <li>Share the items, service ZIP, and preferred timing.</li>
          <li>
            Confirm coverage, accepted materials, access, and the estimate.
          </li>
          <li>Agree on a pickup date when scheduling is available.</li>
        </ol>
        <p>We do not maintain a separate office in {location.name}.</p>
      </aside>
    </section>
    <section class="page-content">
      <h2>Helpful services to explore</h2>
      <ServiceGrid slugs={location.serviceSlugs} />
    </section>
    <section class="page-content">
      <h2>Other communities in our plans</h2>
      <div class="city-list">
        {locations
          .filter((l) => location.nearby.includes(l.slug))
          .map((l) => (
            <a href={`/service-area/${l.slug}`}>{l.name} ↗</a>
          ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .location-hero {
    max-width: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
  }
  .location-hero-copy {
    min-width: 0;
  }
  .location-hero h1 {
    font-size: clamp(2.8rem, 5.4vw, 4.8rem);
  }
  .location-hero-copy > p:not(.eyebrow) {
    font-size: 1.1rem;
    max-width: 38rem;
  }
  .location-landmark {
    margin: 0;
    min-width: 0;
  }
  .location-landmark img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
    background: #eee;
  }
  figcaption {
    border-top: 3px solid var(--orange);
    margin-top: 14px;
    padding-top: 12px;
  }
  .landmark-name {
    display: block;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .landmark-credit {
    margin-top: 4px;
    color: #626262;
    font-size: 0.75rem;
  }
  .landmark-credit summary {
    cursor: pointer;
    width: fit-content;
    padding: 4px 0;
  }
  .landmark-credit p {
    margin: 6px 0 0;
    font-size: inherit;
    line-height: 1.6;
  }
  .landmark-credit a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 800px) {
    .location-hero {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .location-hero h1 {
      font-size: clamp(2.8rem, 9vw, 4.8rem);
    }
    .location-landmark img {
      aspect-ratio: 3 / 2;
    }
  }
</style>
