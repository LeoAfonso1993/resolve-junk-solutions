---
import Layout from '../layouts/Layout.astro';
import { business } from '../data/business';
const connected = Boolean(import.meta.env.PUBLIC_LEAD_ENDPOINT);
const analyticsEnabled = Boolean(import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN);
---

<Layout
  title="Privacy"
  description="How the Resolve Junk Solutions website handles project inquiries, optional photos, and analytics."
  crumbs={[
    { name: 'Home', url: '/' },
    { name: 'Privacy', url: '/privacy' },
  ]}
>
  <div class="wrap">
    <section class="page-hero">
      <p class="eyebrow">YOUR INFORMATION</p>
      <h1>Privacy, plainly.</h1>
    </section>
    <div class="prose page-content">
      <h2>Project inquiries</h2>
      <p>
        {connected
          ? 'The request form sends the details you enter and any photos you choose to attach to our inquiry service. We use them to review your project and respond to you.'
          : `This build cannot submit quote requests. You can contact us at ${business.email}.`}
      </p>
      <p>
        The form asks for a name, service ZIP, a description, and a way to
        respond. It also asks about timing, approximate quantity, access, and
        property type. A street address is required; notes and photos are
        optional. A project inquiry is not a subscription to marketing messages.
      </p>
      {connected && (
        <p>
          Cloudflare processes form submissions and prepares attached photos.
          Resend delivers inquiry emails to the configured business inbox. Your
          contact details, project information, and any attached photos are
          included in that email so we can respond. This Worker does not keep a
          separate inquiry database or publish photos. Email providers may
          retain messages under their own policies; contact us if you need to
          ask about a request.
        </p>
      )}
      <h2>Photos</h2>
      <p>
        Only include images needed to explain the job. Avoid personal documents,
        people, and valuables. Image files can contain embedded location or
        device information.
      </p>
      <h2>Website analytics</h2>
      <p>
        {analyticsEnabled
          ? 'Cloudflare Web Analytics is enabled to measure site visits and performance. It does not receive quote form contents through this site. The website also emits limited local interaction events for quote, phone, email, and form steps; these are not sent to an analytics provider unless a separate integration is configured.'
          : 'No analytics beacon is enabled in this build. The website emits limited local interaction events for quote, phone, email, and form steps; these are not sent to an analytics provider. Hosting providers may process basic request logs to operate the website.'}
      </p>
      <h2>Questions about your information</h2>
      {business.email ? (
        <p>
          Email <a href={`mailto:${business.email}`}>{business.email}</a> with
          questions about information you have shared.
        </p>
      ) : (
        <p>
          Email <a href={`mailto:${business.email}`}>{business.email}</a> with
          questions about information you have shared.
        </p>
      )}
    </div>
  </div>
</Layout>
