---
import { quoteLabel, business, SHOW_PHONE_CTA } from '../data/business';
interface Props {
  label?: string;
  secondary?: boolean;
}
const { label = quoteLabel, secondary = false } = Astro.props;
---

<div class="cta-row">
  <a class="button" href="/contact" data-event="quote_cta_click">
    {label}
    <span aria-hidden="true">↗</span>
  </a>
  {secondary &&
    (business.phone && SHOW_PHONE_CTA ? (
      <a
        class="text-link"
        href={`tel:${business.phoneE164}`}
        data-event="phone_click"
      >
        Call Us <span>{business.phone}</span>
      </a>
    ) : (
      <a class="text-link" href="/services">
        Explore our services <span aria-hidden="true">↗</span>
      </a>
    ))}
</div>
