# Optional same-origin endpoint for a Worker-enabled build. Never place secrets
# in PUBLIC_ variables. `npm run build:worker` sets this to /api/leads.
PUBLIC_LEAD_ENDPOINT=
# Production copy is the default. Set true only for an intentional pre-launch build.
PRE_LAUNCH_MODE=false
# Optional Cloudflare Web Analytics site token. Public token, not a secret.
PUBLIC_CF_WEB_ANALYTICS_TOKEN=
