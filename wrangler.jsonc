{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resolve-junk-solutions",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "images": { "binding": "IMAGES" },
  "ratelimits": [
    {
      "name": "LEAD_RATE_LIMITER",
      "namespace_id": "926202601",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "vars": {
    "LEAD_FROM_EMAIL": "",
    "LEAD_TO_EMAIL": "",
    "ALLOWED_ORIGINS": "https://resolvejunksolutions.com,https://www.resolvejunksolutions.com,https://resolve-junk-solutions.devpro-leo.workers.dev",
  },
  "observability": { "enabled": true, "traces": { "enabled": true } },
}
